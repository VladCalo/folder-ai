# Copy this file to .env and fill in your real values. .env is gitignored — never commit it.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

TENANT_ID=atelierul-verde-demo
TENANT_COMPANY_NAME=Atelierul Verde SRL

# Requires `kubectl -n postgres port-forward svc/postgres 5432:5432` running
# (against the admin@rpi5 context) to reach the real folderai database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=folderai
DB_USER=folderai
DB_PASSWORD=

# Fill in after creating a Slack app (see ../SLACK_BOT_SETUP.md).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
